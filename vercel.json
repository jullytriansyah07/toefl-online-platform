{
  "version": 2,
  "builds": [
    {
      "src": "backend-speaking-test/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend-speaking-test/main.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/build/static/$1"
    },
    {
      "src": "^/(.*)",
      "dest": "/frontend/build/$1"
    },
    {
      "src": "/.*",
      "dest": "/frontend/build/index.html"
    }
  ]
}